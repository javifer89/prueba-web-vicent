{
  "collections": [
    {
      "name": "admins",
      "type": "auth",
      "schema": [
        { "name": "name", "type": "text", "required": true },
        { "name": "role", "type": "select", "options": { "maxSelect": 1, "values": ["admin", "editor"] }, "required": true, "default": "editor" },
        { "name": "avatar", "type": "file", "options": { "maxSelect": 1, "maxSize": 5242880, "mimeTypes": ["image/jpeg", "image/png", "image/webp"], "thumbs": ["100x100"] } }
      ],
      "listRule": "@request.auth.id != \"\"",
      "viewRule": "@request.auth.id != \"\"",
      "createRule": "",
      "updateRule": "@request.auth.id = id",
      "deleteRule": "@request.auth.id = id"
    },
    {
      "name": "categories",
      "type": "base",
      "schema": [
        { "name": "name_ca", "type": "text", "required": true },
        { "name": "name_es", "type": "text", "required": true },
        { "name": "name_en", "type": "text", "required": true },
        { "name": "slug", "type": "text", "required": true, "options": { "pattern": "^[a-z0-9-]+$" } },
        { "name": "type", "type": "select", "options": { "maxSelect": 1, "values": ["news", "events", "compositions", "media", "gallery"] }, "required": true },
        { "name": "order", "type": "number", "required": false, "default": "0" },
        { "name": "color", "type": "text", "options": { "pattern": "^#[0-9a-fA-F]{6}$" } }
